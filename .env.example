OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_MS=60000
# Keep the installed model in memory between turns; no download or cloud call.
OLLAMA_KEEP_ALIVE=15m
# Optional CPU tuning: benchmark on your machine before choosing a thread count.
# OLLAMA_NUM_THREADS=8
# Explicit local LLM GPU opt-in; avatar rendering remains cloud-only.
NEXUS_OLLAMA_GPU=false
AI_MODE=AUTO
NEXUS_FREE_MODE=true
OLLAMA_NO_CLOUD=1
# Optional local llama-server (OpenAI-compatible). No automatic downloads.
# NEXUS_LLAMACPP_BASE_URL=http://127.0.0.1:8080
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
VITE_OLLAMA_MODEL=qwen2.5:1.5b
VITE_NEXUS_AGENT_HUB_URL=http://127.0.0.1:8788
GEMINI_MODEL=gemini-2.5-flash
# Optional server-only credential. Never prefix this with VITE_.
# GEMINI_API_KEY=
# Enable only after verifying this key's project is Free Tier with NO billing account.
# Revoke confirmation before enabling billing. Latest aliases are not allowed in FREE mode.
NEXUS_GEMINI_FREE_CONFIRMED=false
# Optional main model, still blocked unless the FREE verification above is true:
# NEXUS_PRIMARY_PROVIDER=google-gemini
# Optional server-only GitHub connector credential.
# NEXUS_GITHUB_TOKEN=
# Optional server-only Nexus Image Engine connection. Never prefix these with VITE_.
# NEXUS_IMAGE_SERVER_URL=
# NEXUS_IMAGE_SERVER_TOKEN=
# Optional server-only conversation lip-sync worker. Never use VITE_* for credentials.
# NEXUS_AVATAR_SERVER_URL=
# NEXUS_AVATAR_SERVER_TOKEN=
# Set true only after verifying the worker consumes no credits/subscription/paid compute.
# A Colab Pro L4 session consuming compute units is NOT free.
NEXUS_AVATAR_FREE_CONFIRMED=false
