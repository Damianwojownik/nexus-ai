{
  "name": "nexus-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "hub": "node --experimental-strip-types helpers/agentHubRuntime.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:hub": "node --experimental-strip-types --test helpers/agentHub.test.ts",
    "test:image": "node --experimental-strip-types --test helpers/nexusImageIntent.test.ts",
    "test:image-hub": "node --experimental-strip-types --test helpers/nexusImageHub.test.ts",
    "test:agent": "node --experimental-strip-types --test helpers/nexusAgent.test.ts",
    "test:team": "node --experimental-strip-types --test helpers/nexusTeam.test.ts",
    "test:seo": "node --experimental-strip-types --test helpers/seoAuditor.test.ts",
    "test:voice": "node --experimental-strip-types --test helpers/nexusLunaTts.test.ts",
    "mobile:build": "npm run build",
    "mobile:serve": "node scripts/mobile-server.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
